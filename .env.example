# Postgres connection string from Railway.
# Get it from your Railway project: Settings -> Variables -> DATABASE_URL.
# For local dev, you can use Railway's public connection string directly.
DATABASE_URL=postgresql://user:password@host:port/database

# Canonical site URL. Used as `metadataBase` for absolute OG / Twitter image
# URLs. Must point to a resolvable host (the apex `miniklaim.fun` has no DNS
# record yet, so use the `www` subdomain). Override in prod via Railway env.
NEXT_PUBLIC_SITE_URL=https://www.miniklaim.fun

# Contract addresses (multichain registry in lib/onchain/chains.ts).
# Celo mainnet (chain 42220).
NEXT_PUBLIC_CELO_HEXES_ADDRESS=0x9945dDEAa9C52c3C4e667B71B698c4e4551F242B
NEXT_PUBLIC_CELO_BADGES_ADDRESS=0x79c5d6365f447d1F707EA6d4bDE5D6A96f181cf7
# Celo Sepolia testnet (chain 11142220). Leave empty if not deployed there.
NEXT_PUBLIC_CELO_SEPOLIA_HEXES_ADDRESS=
NEXT_PUBLIC_CELO_SEPOLIA_BADGES_ADDRESS=

# MiniKlaimRewards address (holds USDm, players call claimRewards). Optional.
# Leave empty until the contract is deployed and funded. UI + backend gate on
# this being set: the rewards section stays hidden and the voucher endpoint
# returns 503 when unset. Rewards MVP is Celo-only; Soneium has no USDm.
NEXT_PUBLIC_CELO_REWARDS_ADDRESS=
NEXT_PUBLIC_CELO_SEPOLIA_REWARDS_ADDRESS=
# Soneium mainnet (chain id 1868). Deployed 2026-06-17, verified on Blockscout.
NEXT_PUBLIC_SONEIUM_HEXES_ADDRESS=0x4FE122eC088501Be53c5a12E1f0F313eD71AeB4C
NEXT_PUBLIC_SONEIUM_BADGES_ADDRESS=0xa9ab7390f79B937C9c0a1FDFA1A40C2E145eAbd8

# MiniKlaimClaimRouter address. Optional. When set, finishing a run settles
# hexes and badges in ONE transaction, so the player sees a single wallet
# approval instead of two (MiniPay is EIP-1193 only, no EIP-5792, so the
# bundling has to happen in a contract). When unset the app falls back to the
# two-tx claimRun + claimBadges path, so it is safe to leave empty until the
# router is deployed and granted CAPTURER_ROLE on Hexes + MINTER_ROLE on Badges.
NEXT_PUBLIC_CELO_CLAIM_ROUTER_ADDRESS=
NEXT_PUBLIC_CELO_SEPOLIA_CLAIM_ROUTER_ADDRESS=
NEXT_PUBLIC_SONEIUM_CLAIM_ROUTER_ADDRESS=

# Set to 1 once the chain's Hexes proxy runs v2 (records captures instead of
# minting a token per hex). Raises the one-tx limit to 8,000 hexes and turns on
# "mint your blocks" in the profile. Celo mainnet: 1 since 2026-10-20.
NEXT_PUBLIC_CELO_HEXES_RECORDS=
NEXT_PUBLIC_CELO_SEPOLIA_HEXES_RECORDS=
NEXT_PUBLIC_SONEIUM_HEXES_RECORDS=

# ERC-8021 attribution tag issued by the Celo Attribution Tag Registry
# (celo_xxxxxxxx). Appended to every write tx so Celo credits the activity to
# MiniKlaim. Keep the real value out of the repo; Celo asks it stay private.
# Build-time (NEXT_PUBLIC): redeploy after changing it. Empty = txs untagged.
NEXT_PUBLIC_CELO_ATTRIBUTION_CODE=

# Server signer with CAPTURER_ROLE on Hexes and MINTER_ROLE on Badges, plus
# VOUCHER_SIGNER_ROLE on MiniKlaimClaimRouter when that is deployed.
# Hot key on Railway; rotate annually or on suspected leak.
SERVER_SIGNER_PRIVATE_KEY=0x...

# Relayer sponsorship limits (optional, defaults shown). Hexes the relayer mints
# per wallet per rolling 24h, sponsored badge txs per wallet per 24h, and the
# CELO balance under which the relayer raises a Sentry alert.
SPONSOR_DAILY_HEX_CAP=200   # production: 10000
SPONSOR_DAILY_BADGE_TX_CAP=2
RELAYER_LOW_BALANCE_CELO=5

# Destination address for the "prove wallet ownership" tx used by the link flow.
# The client sends a 0-value tx to this address with keccak256(code) as calldata;
# the backend reads the receipt to identify the redeemer. Same on Celo + Soneium
# (single relayer/admin EOA). Change if you rotate the relayer.
NEXT_PUBLIC_LINK_VERIFIER_ADDRESS=0x8da26Ae1B32a7e4Cd158622D7d70Fe16D6F1dE83

# PostHog product analytics client key (phc_...). Public, safe to expose in
# the browser bundle. Leave empty to disable analytics entirely (init no-ops).
# The Personal API Key that manages the project stays out of source; it lives
# in macOS Keychain (acct=0xj4an-personal, svce=POSTHOG_PERSONAL_API_KEY) for
# the PostHog MCP wrapper. Requests are proxied same-origin through /ingest
# (see next.config.ts) to bypass mobile ad blockers.
NEXT_PUBLIC_POSTHOG_KEY=

# Sentry client DSN for the miniklaim project in org 0xj4an. Public, safe in
# the browser bundle. Leave empty to disable Sentry. Events are proxied
# same-origin through /monitoring so MiniPay does not drop them.
# Source map upload reads SENTRY_AUTH_TOKEN at build time. That token stays
# out of source.
NEXT_PUBLIC_SENTRY_DSN=

# Resend API key (sending access for miniklaim.fun). The in-app support form
# posts to /api/support, which sends the ticket to support@miniklaim.fun from
# app@miniklaim.fun with reply-to set to the player. Unset: the endpoint answers
# 503 and the form falls back to opening the player's email app.
RESEND_API_KEY=
