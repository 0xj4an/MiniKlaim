    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "h3-js": "^4.4.0",
    "maplibre-gl": "^5.24.0",
    "next": "^16.2.6",
    "postgres": "^3.4.9",
    "posthog-js": "^1.414.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "viem": "^2.49.3",
    "wagmi": "^3.6.15"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.12",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
