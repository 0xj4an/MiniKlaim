{
  "name": "miniklaim",
  "version": "0.0.1",
  "private": true,
  "description": "Run it. Klaim it. A territory-capture MiniPay app on Celo — cross blocks any way you move (walk, run, bike, drive).",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed:world": "tsx scripts/seed-world.ts",
